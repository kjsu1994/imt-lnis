# 송신 PC는 sender, 수신 PC는 receiver. 두 PC에서 주소 순서를 서로 바꾸세요.
LNIS_NODE_ROLE=sender
LNIS_SERVER_PORT=8088
LNIS_NODE_BASE_URL=http://192.168.1.72:8088
LNIS_NODE_PEER_URL=http://192.168.1.73:8088
# 임의의 긴 값으로 변경하고 양쪽에 같은 값을 설정하세요. DTN 수신 토큰과는 별개입니다.
LNIS_NODE_MANAGEMENT_TOKEN=
LNIS_DB_PASSWORD=
LNIS_DTN_SEND_URL=
LNIS_DTN_RECEIVE_URL=
LNIS_DTN_SEND_TOKEN=
# 수신 PC 필수. 외부 DTN/HDTN 수신 어댑터가 이 토큰으로 callback을 호출합니다.
LNIS_DTN_RECEIVE_TOKEN=
# 실제 GNSS 장치를 연결할 송신 PC에서만 아래 세 줄을 활성화하세요.
# COMPOSE_FILE=docker-compose.yml:docker-compose.serial.yml
# LNIS_SERIAL_DEVICE=/dev/serial/by-id/실제-장치-ID
# LNIS_SERIAL_GID=20
