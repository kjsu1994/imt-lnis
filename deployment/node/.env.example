# PC별 설치 설정. INSTALL.cmd가 이 설명을 유지한 채 .env를 생성합니다.
# sender: 송신 PC / receiver: 수신 PC. 같은 PC에 두 역할을 설치하는 개발 구성과 구분합니다.
LNIS_NODE_ROLE=sender
# 화면, REST API, Docker 게시 포트에 함께 사용하는 번호입니다. 양쪽 PC는 모두 8088을 써도 됩니다.
# 다른 프로그램이 사용 중인 포트는 지정할 수 없습니다. 변경 후 INSTALL.cmd로 네트워크 설정을 다시 적용하세요.
LNIS_SERVER_PORT=8088
# 현재 PC의 고정 IPv4 주소와 위 포트. WSL의 172.x 내부 주소를 입력하지 않습니다.
LNIS_NODE_BASE_URL=http://192.168.1.72:8088
# 상대 PC의 Windows IPv4 주소와 서비스 포트. 모르면 비워 두고 시험 화면에서 나중에 설정합니다.
LNIS_NODE_PEER_URL=http://192.168.1.73:8088
# 양쪽 서비스가 동일하게 사용하는 관리 인증값입니다. 기본값은 imt123입니다.
# 서비스·어댑터 인증값의 용도는 구분하며, 기본값은 모두 imt123입니다. URL에는 넣지 않습니다.
LNIS_NODE_MANAGEMENT_TOKEN=imt123
# 기존 DB에서 사용한 비밀번호가 있으면 그대로 유지합니다. 사용하지 않으면 비워둡니다.
LNIS_DB_PASSWORD=
# 현재 PC가 연결할 DTN/HDTN 어댑터 주소. IP와 포트까지만 입력합니다 (/transfers 제외).
# 모르면 비워 두고 시험 화면에서 나중에 설정합니다.
dtn_adapter=http://192.168.1.154:8080
# 송신 어댑터가 요구하는 인증값. Bearer 접두어 없이 값만 입력합니다. 인증이 없으면 비워둡니다.
LNIS_DTN_SEND_TOKEN=imt123
# 수신 PC 필수. 수신 어댑터가 LNIS callback을 호출할 때 사용하는 인증값과 동일하게 지정합니다.
LNIS_DTN_RECEIVE_TOKEN=imt123
# 송신 PC의 I/Q 생성 사용 여부. INSTALL.cmd의 새 설치에서는 송신 true, 수신 false로 설정합니다.
LNIS_IQ_ENABLED=false
# Windows 어댑터가 접근할 현재 PC의 I/Q 폴더입니다. 송신·수신 어댑터와 각자 공유해야 합니다.
# INSTALL.cmd는 설치 경로의 exchange를 입력합니다. 파일은 자동으로 상대 PC로 복사되지 않습니다.
LNIS_IQ_HOST_PATH=
# Windows COM 중계의 내부 포트. 새 설치 기본값은 송신 18765 / 수신 18766입니다.
# 새 설치는 사용 중인 포트를 피해 자동 지정합니다. 변경 후 INSTALL.cmd로 방화벽을 갱신합니다.
# COM 번호(COM4 등)는 웹 화면에서 선택합니다.
LNIS_SERIAL_BRIDGE_PORT=
# 특별한 네트워크에서만 지정합니다. 보통 비워두면 START가 WSL 호스트 주소를 자동 탐지합니다.
LNIS_SERIAL_BRIDGE_BIND=
# WSL 서비스가 Windows COM 중계에 연결할 주소. 보통 자동 탐지하며 필요할 때만 입력합니다.
LNIS_SERIAL_BRIDGE_HOST=
# 평상시 INFO를 유지합니다. HTTP 헤더 등의 진단이 필요할 때 DEBUG로 바꾼 뒤 START를 실행합니다.
LNIS_HTTP_LOG_LEVEL=INFO
# 아래 항목은 설치 스크립트가 관리합니다. 직접 수정하지 않습니다.
# 기존 개발 PC에서 START를 사용할 경우, 실제 배포판 이름(예: Ubuntu)을 지정합니다.
LNIS_WSL_DISTRIBUTION=Ubuntu
# 설치별 컨테이너를 분리하는 Compose 프로젝트 이름. 설치 시 자동 지정합니다.
LNIS_COMPOSE_PROJECT=
# 설치한 서비스 이미지의 고유 태그. START는 이미지를 내려받거나 빌드하지 않습니다.
LNIS_NODE_IMAGE=lnis-node:local
# 컨테이너 DB·exchange와 COM 환경 파일을 연결할 WSL 기준 경로. 빈 값은 현재 폴더입니다.
LNIS_STATE_DIR=
