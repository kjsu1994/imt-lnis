# 송신 PC는 sender, 수신 PC는 receiver. 두 PC에서 주소 순서를 서로 바꾸세요.
LNIS_NODE_ROLE=sender
LNIS_SERVER_PORT=8088
LNIS_NODE_BASE_URL=http://192.168.1.72:8088
LNIS_NODE_PEER_URL=http://192.168.1.73:8088
# 임의의 긴 값으로 변경하고 양쪽에 같은 값을 설정하세요. DTN 수신 토큰과는 별개입니다.
LNIS_NODE_MANAGEMENT_TOKEN=
LNIS_DB_PASSWORD=
dtn_adapter=http://192.168.1.154:8080
LNIS_DTN_SEND_TOKEN=
# 수신 PC 필수. 외부 DTN/HDTN 수신 어댑터가 이 토큰으로 callback을 호출합니다.
LNIS_DTN_RECEIVE_TOKEN=
# 송신 PC에서만 I/Q 생성 활성화. 양쪽 어댑터와 ./exchange를 /exchange로 공유하세요.
LNIS_IQ_ENABLED=false
# Windows COM 브리지: 비우면 기존 포트 유지, 새 설치는 송신 18765 / 수신 18766.
# 포트 변경은 이곳에서만 지정하고 START.cmd로 다시 기동하세요. 범위: 1~65535.
LNIS_SERIAL_BRIDGE_PORT=
# 주소는 WSL 네트워크에서 자동 감지합니다. 수동 지정이 필요한 PC에서만 사용하세요.
# LNIS_SERIAL_BRIDGE_BIND=172.24.176.1
# LNIS_SERIAL_BRIDGE_HOST=172.24.176.1
# Windows COM 번호는 화면의 포트 조회에서 선택합니다.

# USB를 Windows 대신 WSL에 직접 연결할 때만 아래 세 줄을 활성화하세요.
# COMPOSE_FILE=docker-compose.yml:docker-compose.serial.yml
# LNIS_SERIAL_DEVICE=/dev/serial/by-id/실제-장치-ID
# LNIS_SERIAL_GID=20

# HTTP 조회/헤더 진단이 필요할 때만 DEBUG로 바꾸고 컨테이너를 재생성합니다.
LNIS_HTTP_LOG_LEVEL=INFO
